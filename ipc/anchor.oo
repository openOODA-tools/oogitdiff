// # IPC Subsystem Anchor
//
// Logline: Consolidates JSON parsing, command-line arguments decoding, and MCP server handling.
//
// Setup: Central entry point for all protocol and options parsing in oogitdiff.
//
// Beats:
//   1. Re-export JSON field extraction and RFC 8259 escaping routines.
//   2. Re-export CLI options parser and help/version text formatters.
//   3. Re-export Model Context Protocol (MCP) JSON-RPC 2.0 stdio server.
//   4. Execute verification tests validating parsing integrity across IPC components.

import "json_field.oo";
import "cli_options.oo";
import "mcp_server.oo";

pub fn verify_ipc_subsystem() -> Bool {
    let dummy_json: String = "{\"method\":\"ping\",\"id\":42}";
    let method: String = json_extract_str_field(dummy_json, "method");
    if method != "ping" {
        return false;
    }
    let id: Int = json_extract_int_field(dummy_json, "id", 0);
    if id != 42 {
        return false;
    }

    let dummy_args: List[String] = list_push(list_new(), "--stat");
    let opts: CliOptions = parse_cli_options(dummy_args);
    if !opts.show_stat {
        return false;
    }

    return true;
}
