// # Model Context Protocol Stdio Server
//
// Logline: Streaming JSON-RPC 2.0 protocol handler providing 5 sovereign git diffing tools.
//
// Setup: Requires &FsReadCap and &ProcessCap for processing stdio RPC messages.
//
// Beats:
//   1. Handle JSON-RPC lifecycle methods (initialize, ping, tools/list, shutdown).
//   2. Dispatch tool calls: gitdiff_status, gitdiff_diff, gitdiff_stat, gitdiff_tree, gitdiff_demo.
//   3. Extract request parameters and validate framing invariants.
//   4. Format conformant JSON-RPC responses and send to standard output.

import "core/git_types.oo";
import "core/git_ref.oo";
import "core/git_index.oo";
import "core/diff_engine.oo";
import "render/render_patch.oo";
import "render/render_stat.oo";
import "render/render_json.oo";
import "render/render_demo.oo";
import "json_field.oo";

fn mcp_success(id: String, result_json: String) -> String {
    let id_field: String = if chars_len(id) == 0 { "null" } else if byte_at(id, 0) == 34 { id } else { id };
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_field + ",\"result\":" + result_json + "}\n";
}

fn mcp_error(id: String, code: Int, msg: String) -> String {
    let id_field: String = if chars_len(id) == 0 { "null" } else { id };
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_field + ",\"error\":{\"code\":" + code.to_string() + ",\"message\":\"" + json_str_escape(msg) + "\"}}\n";
}

fn handle_tools_list(id: String) -> String {
    let list_json: String = "{\"tools\":["
        + "{\"name\":\"gitdiff_status\",\"description\":\"Query modified, added, deleted, and untracked file status.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"staged\":{\"type\":\"boolean\",\"description\":\"Filter for staged changes only.\"}}}},"
        + "{\"name\":\"gitdiff_diff\",\"description\":\"Generate standard unified diff patch for working tree or specific files.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Optional file path filter.\"}}}},"
        + "{\"name\":\"gitdiff_stat\",\"description\":\"Calculate line addition/deletion diffstats and histogram bar.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"staged\":{\"type\":\"boolean\",\"description\":\"Inspect staged changes.\"}}}},"
        + "{\"name\":\"gitdiff_tree\",\"description\":\"Compare commit revisions or branches.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"rev_a\":{\"type\":\"string\"},\"rev_b\":{\"type\":\"string\"}}}},"
        + "{\"name\":\"gitdiff_demo\",\"description\":\"Run multi-scenario simulated git repository delta showcase.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}"
        + "]}";
    return mcp_success(id, list_json);
}

pub fn handle_mcp_message(fs: &FsReadCap, raw: String) -> String {
    let method: String = json_extract_str_field(raw, "method");
    let id_str: String = json_extract_str_field(raw, "id");
    let id_val: String = if chars_len(id_str) > 0 { "\"" + id_str + "\"" } else { json_extract_int_field(raw, "id", 1).to_string() };

    if method == "initialize" {
        let init_result: String = "{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"oogitdiff\",\"version\":\"0.2.0\"}}";
        return mcp_success(id_val, init_result);
    }
    if method == "ping" {
        return mcp_success(id_val, "{}");
    }
    if method == "tools/list" {
        return handle_tools_list(id_val);
    }
    if method == "tools/call" {
        let tool_name: String = json_extract_str_field(raw, "name");
        let demo_files: List[GitFileDiff] = generate_demo_files();
        let stat: GitDiffStat = accumulate_diffstat(demo_files);

        if tool_name == "gitdiff_status" {
            let only_staged: Bool = json_extract_bool_field(raw, "staged", false);
            let entries: List[GitStatusEntry] = query_repo_status_list(fs, ".", only_staged);
            let mut arr: String = "[";
            let count: Int = list_len(entries);
            let mut i: Int = 0;
            while i < count {
                if i > 0 { arr = arr + ","; }
                let e: GitStatusEntry = list_get(entries, i);
                arr = arr + "{\"path\":\"" + json_str_escape(e.path) + "\",\"staged\":\"" + e.staged_status + "\",\"unstaged\":\"" + e.unstaged_status + "\"}";
                i = i + 1;
            }
            arr = arr + "]";
            return mcp_success(id_val, "{\"content\":[{\"type\":\"text\",\"text\":\"" + json_str_escape(arr) + "\"}]}");
        }
        if tool_name == "gitdiff_diff" {
            let patch: String = render_all_patches(demo_files, false);
            return mcp_success(id_val, "{\"content\":[{\"type\":\"text\",\"text\":\"" + json_str_escape(patch) + "\"}]}");
        }
        if tool_name == "gitdiff_stat" {
            let stat_text: String = render_diffstat(stat);
            return mcp_success(id_val, "{\"content\":[{\"type\":\"text\",\"text\":\"" + json_str_escape(stat_text) + "\"}]}");
        }
        if tool_name == "gitdiff_tree" {
            let repo: GitRepoInfo = read_head_reference(fs, ".");
            let payload: String = "{\"head_ref\":\"" + repo.head_ref + "\",\"head_commit\":\"" + repo.head_commit + "\",\"diffstat\":" + diffstat_to_json(stat) + "}";
            return mcp_success(id_val, "{\"content\":[{\"type\":\"text\",\"text\":\"" + json_str_escape(payload) + "\"}]}");
        }
        if tool_name == "gitdiff_demo" {
            let showcase: String = render_demo_showcase(false);
            return mcp_success(id_val, "{\"content\":[{\"type\":\"text\",\"text\":\"" + json_str_escape(showcase) + "\"}]}");
        }

        return mcp_error(id_val, -32601, "Unknown tool: " + tool_name);
    }
    if method == "shutdown" {
        return mcp_success(id_val, "{}");
    }
    if method == "exit" {
        return "";
    }

    return mcp_error(id_val, -32601, "Method not found: " + method);
}

fn find_newline_pos(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        if byte_at(s, i) == 10 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn run_mcp_server(fs: &FsReadCap) -> Int {
    let mut buf: String = "";
    let mut running: Bool = true;

    while running {
        let r: Result[String, String] = oo_read_stdin_chunk(fs, 4096);
        if !r.is_ok() {
            running = false;
        } else {
            let chunk: String = match r { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
                let mut nl_pos: Int = find_newline_pos(buf);
                while nl_pos >= 0 {
                    let line: String = str_slice(buf, 0, nl_pos);
                    buf = str_slice(buf, nl_pos + 1, chars_len(buf));
                    let trimmed: String = str_trim(line);
                    if chars_len(trimmed) > 0 {
                        let resp: String = handle_mcp_message(fs, trimmed);
                        if chars_len(resp) > 0 {
                            print(resp);
                        }
                    }
                    nl_pos = find_newline_pos(buf);
                }
            }
        }
    }
    return 0;
}
