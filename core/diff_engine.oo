// # Diff Engine and Hunk Generator
//
// Logline: Calculates line-level differences, groups edit deltas, and constructs unified diff hunks.
//
// Setup: Pure algorithmic comparison engine operating on text strings and line lists.
//
// Beats:
//   1. Split text streams into line arrays while preserving whitespace fidelity.
//   2. Compare before/after line sequences and classify additions, deletions, and context.
//   3. Group neighboring modifications into cohesive unified diff hunks.
//   4. Calculate aggregate addition and deletion metrics for file-level diffstats.

import "git_types.oo";

pub fn split_lines(content: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let length: Int = chars_len(content);
    let mut start: Int = 0;
    let mut i: Int = 0;

    while i < length {
        let ch: String = str_slice(content, i, i + 1);
        if ch == "\n" {
            let line: String = str_slice(content, start, i);
            lines = list_push(lines, line);
            start = i + 1;
        }
        i = i + 1;
    }

    if start < length {
        let last_line: String = str_slice(content, start, length);
        lines = list_push(lines, last_line);
    }

    return lines;
}

pub fn compute_file_diff(
    file_path: String,
    old_content: String,
    new_content: String,
    old_sha: String,
    new_sha: String,
    status_hint: String
) -> GitFileDiff {
    let old_lines: List[String] = split_lines(old_content);
    let new_lines: List[String] = split_lines(new_content);

    let n_old: Int = list_len(old_lines);
    let n_new: Int = list_len(new_lines);

    // Determine status
    let mut resolved_status: String = status_hint;
    if n_old == 0 && n_new > 0 {
        resolved_status = "A";
    }
    if n_old > 0 && n_new == 0 {
        resolved_status = "D";
    }
    if chars_len(resolved_status) == 0 {
        resolved_status = "M";
    }

    let mut hunk_lines: List[GitDiffLine] = list_new();
    let mut additions: Int = 0;
    let mut deletions: Int = 0;

    // Linear alignment & change extraction
    let mut oi: Int = 0;
    let mut ni: Int = 0;

    while oi < n_old || ni < n_new {
        if oi < n_old && ni < n_new {
            let o_line: String = list_get(old_lines, oi);
            let n_line: String = list_get(new_lines, ni);

            if o_line == n_line {
                // Context line
                let dl: GitDiffLine = make_diff_line(0, o_line, oi + 1, ni + 1);
                hunk_lines = list_push(hunk_lines, dl);
                oi = oi + 1;
                ni = ni + 1;
            } else {
                // Modified: deletion followed by addition
                let dl_del: GitDiffLine = make_diff_line(2, o_line, oi + 1, 0);
                hunk_lines = list_push(hunk_lines, dl_del);
                deletions = deletions + 1;
                oi = oi + 1;

                let dl_add: GitDiffLine = make_diff_line(1, n_line, 0, ni + 1);
                hunk_lines = list_push(hunk_lines, dl_add);
                additions = additions + 1;
                ni = ni + 1;
            }
        } else if oi < n_old {
            // Remaining deletions
            let o_line: String = list_get(old_lines, oi);
            let dl_del: GitDiffLine = make_diff_line(2, o_line, oi + 1, 0);
            hunk_lines = list_push(hunk_lines, dl_del);
            deletions = deletions + 1;
            oi = oi + 1;
        } else {
            // Remaining additions
            let n_line: String = list_get(new_lines, ni);
            let dl_add: GitDiffLine = make_diff_line(1, n_line, 0, ni + 1);
            hunk_lines = list_push(hunk_lines, dl_add);
            additions = additions + 1;
            ni = ni + 1;
        }
    }

    let mut hunks: List[GitDiffHunk] = list_new();
    if additions > 0 || deletions > 0 {
        let hunk: GitDiffHunk = make_diff_hunk(
            if n_old == 0 { 0 } else { 1 },
            n_old,
            if n_new == 0 { 0 } else { 1 },
            n_new,
            hunk_lines
        );
        hunks = list_push(hunks, hunk);
    }

    return make_file_diff(
        file_path,
        "100644",
        "100644",
        old_sha,
        new_sha,
        resolved_status,
        additions,
        deletions,
        hunks
    );
}

pub fn accumulate_diffstat(files: List[GitFileDiff]) -> GitDiffStat {
    let count: Int = list_len(files);
    let mut total_add: Int = 0;
    let mut total_del: Int = 0;
    let mut i: Int = 0;

    while i < count {
        let f: GitFileDiff = list_get(files, i);
        total_add = total_add + f.additions;
        total_del = total_del + f.deletions;
        i = i + 1;
    }

    return GitDiffStat {
        total_files: count,
        total_additions: total_add,
        total_deletions: total_del,
        files: files
    };
}
